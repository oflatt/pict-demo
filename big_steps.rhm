#lang rhombus/static

// Big-step animation: for each subexpression evaluated by a
// big-step schedule, push the subexpression out to the side,
// run its own animation, then pop the resulting value back into
// place. Driven by an `Eval` tree produced by `eval_tree`.

import:
  // exclude pict's `magic_move` so it doesn't collide with the
  // hand-written one in "magic_move.rhm"
  pict:
    open
    except: magic_move
  "morph.rhm" open
  "magic_move.rhm" open
  "max_bounds.rhm" open
  "eval_tree.rhm" open

export:
  big_steps

// Animates one big step: starts with `gray_sub` shown in place
// inside `all`, slides it out to the right (with `all` shrunk),
// runs `eval_sub` for the subexpression's own evaluation, then
// slides the resulting value back into the hole.
fun slide_out_and_back(
  all :: Pict,        // enclosing expression
  gray_sub :: Pict,   // grayed subexpression already in place
  eval_sub :: Pict    // evaluation animation for that subexpression
) :: Pict:
  // start and end of subexpression evaluation:
  let start_sub = eval_sub.snapshot()
  let end_val = eval_sub.snapshot(eval_sub.duration-1, 1)
  // a placeholder for where `end_val` should land, needed
  // so that `end_val`'s identity is distinct in key frames
  let end_blank = end_val.blank()
  // "before" key frame
  let in_pre = pin(~on: all,
                   ~at: Find(gray_sub),
                   ~pinhole: Find(start_sub),
                   start_sub)
  // "push" key frame, before subexpression eval
  let out = beside(~sep: 50,
                   all.scale(0.5),
                   overlay(start_sub,
                           max_bounds(start_sub).blank()))
  // subexpression eval done key frame:
  let out_done:
    out.replace(gray_sub, morph(gray_sub, end_blank))
      .replace(start_sub, end_val)
  // "pop" key frame
  let in_post:
    pin(~on: all.replace(gray_sub, end_blank),
        ~at: Find.top_left(end_blank),
        end_val)
  // build the sequence
  switch(
    magic_move(in_pre, out),
    out.replace(start_sub, eval_sub),
    magic_move(out_done, in_post),
    ~join: #'splice
  )

// Walks the `Eval` tree, recursively animating sub-evaluations
// and then the surrounding reduction step.
fun big_steps(prev_p :: Pict, Eval(subs, step, tail), ~as_tail = #false) :: Pict:
  match step
  | #false:
      big_sub_steps(prev_p, subs)
  | Step(from, to):
      fun local_steps(prev_p :: Pict) :~ Pict:
        let new_from = big_sub_steps(prev_p, subs)
        let next_from = new_from.snapshot(new_from.duration-1, 1)
        let done_from = switch(new_from, morph(next_from, to), ~join: #'splice)
        if tail
        | big_steps(done_from.sustain(), tail, ~as_tail: #true)
        | done_from
      if as_tail
      | local_steps(prev_p)
      | let done_from = local_steps(from)
        let p = prev_p.snapshot(prev_p.duration-1, 1)
        let gray_from = from.alpha(0.25)
        let p_no_from = p.replace(from, gray_from)
        let done_from = done_from.sustain()
        switch(prev_p,
               slide_out_and_back(p_no_from, gray_from, done_from),
               ~join: #'splice)

fun big_sub_steps(prev_p :: Pict, evals :: List) :: Pict:
  // Fold over big steps
  for values(prev_p = prev_p) (eval in evals):
    big_steps(prev_p, eval)
