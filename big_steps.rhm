#lang rhombus/static
import:
  pict open
  "morph.rhm" open
  "magic_move.rhm" open
  "max_bounds.rhm" open
  "eval_tree.rhm" open

export:
  big_steps

// The pict `p` has a subexpression grayed out as `gray_sub`,
// while `eval_sub` is the evaluation animation for that subexpression
fun x_slide_out_and_back(p :: Pict, gray_sub :: Pict, eval_sub :: Pict) :~ Pict:
  let start_sub = eval_sub.snapshot()
  let end_val = eval_sub.snapshot(eval_sub.duration-1, 1)
  // Start with the initial subexpression on top of its grayed version
  let in_pre = pin(~on: p,
                   ~at: Find(gray_sub),
                   ~pinhole: Find(start_sub),
                   start_sub)
  // Target pict has the subexpression out to the right, with
  // the context scaled down by 50%
  let out = beside(~sep: 50,
                   p.scale(0.5),
                   overlay(start_sub,
                           // Use enough room to fit the largst
                           // evaluation step:
                           max_bounds(start_sub).blank()))
  // Placeholder for the subexpression value to move into place:
  let end_blank = end_val.blank()
  // After subexpression evaluation is done, morph context
  // around `end_val` shape, and final value is meanwhile
  // still out to the left
  let out_done:
    out
      .replace(gray_sub, morph(gray_sub, end_blank))
      .replace(start_sub, end_val)
  // Final value in place of the subexpression
  let in_post:
    // substitute `end_blank` and then pin on it,
    // instead of substituting `end_val` directly,
    // so that `end_val` can move independently from
    // the pict containing `gray_from`
    pin(~on: p.replace(gray_sub, end_blank),
        ~at: Find.top_left(end_blank),
        end_val)
  // Animate the sequence
  switch(
    ~join: #'splice,
    // move ubexpression out:
    magic_move(in_pre, out),
    // subexpression's evaluation sequence:
    out.replace(start_sub, eval_sub),
    // move result back in:
    magic_move(out_done, in_post)
  )

// version 2:
fun slide_out_and_back(p :: Pict, gray_sub :: Pict, eval_sub :: Pict) :~ Pict:
  big_step_subexpr(p, gray_sub, eval_sub)

fun big_step_subexpr(
  all :: Pict,        // enclosing expression
  gray_sub :: Pict, // gray subexpression that's already in place:      
  eval_sub :: Pict  // evaluation animation for subexpression:
) :: Pict:
  // start and end of subexpression evaluation:
  let start_sub = eval_sub.snapshot()
  let end_val = eval_sub.snapshot(eval_sub.duration-1, 1)
  // a placeholder for where `env_val` should land, needed
  // so that `end_val` identity is distinct in key frames
  let end_blank = end_val.blank()
  // "before" key frame
  let in_pre = pin(~on: all,
                   ~at: Find(gray_sub),
                   ~pinhole: Find(start_sub),
                   start_sub)
  // "push" key frame, before subexpression eval
  let out = beside(~sep: 50,
                   all.scale(0.5),
                   overlay(start_sub,
                           max_bounds(start_sub).blank()))
  // subexpression eval done key frame:
  let out_done:
    out.replace(gray_sub, morph(gray_sub, end_blank))
      .replace(start_sub, end_val)
  // "pop" key frame
  let in_post:
    pin(~on: all.replace(gray_sub, end_blank),
        ~at: Find.top_left(end_blank),
        end_val)
  // build the sequence
  switch(
    magic_move(in_pre, out),
    out.replace(start_sub, eval_sub),
    magic_move(out_done, in_post),
    ~join: #'splice
  )

fun big_steps(prev_p :: Pict, Eval(subs, step, tail), ~as_tail = #false) :: Pict:
  match step
  | #false:
      big_sub_steps(prev_p, subs)
  | Step(from, to):
      fun local_steps(prev_p :: Pict) :~ Pict:
        let new_from = big_sub_steps(prev_p, subs)
        let next_from = new_from.snapshot(new_from.duration-1, 1)
        let done_from = switch(new_from, morph(next_from, to), ~join: #'splice)
        if tail
        | big_steps(done_from.sustain(), tail, ~as_tail: #true)
        | done_from
      if as_tail
      | local_steps(prev_p)
      | let done_from = local_steps(from)
        let p = prev_p.snapshot(prev_p.duration-1, 1)
        let gray_from = from.alpha(0.25)
        let p_no_from = p.replace(from, gray_from)
        let done_from = done_from.sustain()
        switch(prev_p,
               slide_out_and_back(p_no_from, gray_from, done_from),
               ~join: #'splice)

fun big_sub_steps(prev_p :: Pict, evals :: List) :: Pict:
  // Fold over big steps
  for values(prev_p = prev_p) (eval in evals):
    big_steps(prev_p, eval)
