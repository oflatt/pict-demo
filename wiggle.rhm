#lang rhombus/static

// `wiggle` returns an animation that gently rocks `p` back and
// forth by rotating it ±0.1 radian over one period. The original
// `p` stays as a ghost so the rocking doesn't shift surrounding
// layout.

import:
  pict open

export:
  wiggle

fun wiggle(p :: Pict) :: Pict:
  animate(
    fun (n):
      let q = p.rotate(1/10 * math.sin(n * 2 * math.pi))
      overlay(p.ghost(), q.launder()).refocus(p),
  )
