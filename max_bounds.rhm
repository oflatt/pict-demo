#lang rhombus/static

// Returns a ghost pict whose bounding box is the union of `p`'s
// bounding boxes across every epoch of its animation. Useful for
// reserving space so an animation that grows/shrinks doesn't shift
// surrounding layout.

import:
  pict open

export:
  max_bounds

fun max_bounds(p :: Pict) :~ Pict:
  rebuildable(
    ~deps: [p],
    fun (~deps: [p :: Pict]):
      let b :~ Pict:
        for values(b = p.snapshot()) (i in 0..p.duration):
          overlay(b, p.snapshot(i, 1))
      // the rebuild prompt here is just a performance hint,
      // since any rebuild would discard the ghost and call
      // the enclosing function again, anyway
      b.ghost().launder(~rebuild_prompt: #true)
  )
