#lang rhombus/static/and_meta
import:
  "config.rhm"
  pict open
  pict/radial.arrow
  pict/rhombus open
  "eval_tree.rhm" open
  "small_steps.rhm" open
  "big_steps.rhm" open
  "morph.rhm" open
  "wiggle.rhm" open
  "max_bounds.rhm" open

export:
  fish_code
  fish_val
  fish_sched
  eval_steps_code
  static_reduction
  morph_example
  wiggle_example
  eval_slide_code
  big_step_sequence

defn.macro 'define_also_source_pict $name: $defn':
  '
    $defn
    def $name = rhombusblock($defn)
  '

define_also_source_pict eval_steps_code:
  def [fish_code :: Pict, fish_steps :: List.of(List.of(Pict))]:
    eval_steps:
      overlay(ellipse(~width: 50,
                      ~height: 25,
                      ~fill: "lightblue"),
              ~dx: 30, ~dy: 0,
              triangle(~size: 25,
                       ~fill: "lightblue")
                .rotate(1/2 * math.pi))

let steps :~ List.of(Pict):
  for fold(ps :~ List.of(Pict) = [fish_code]):
    each [from, to] in fish_steps
    ps ++ [ps.last.replace(from, to)]
  
def static_reduction:
  let arrow = arrow(~length: 20, ~fill: "forestgreen").pad(~horiz: 20)
  let h_arrow = arrow.pad(~horiz: 20) // even more space
  unless steps.length() == 5
  | error("revise reduction layout!")
  stack.right(beside.center(steps[0],
                            h_arrow,
                            steps[1]),
              overlay(arrow.rotate(-1/2 * math.pi),
                      blank(~width: steps[1].width)),
              beside.center(steps[4],
                            h_arrow.hflip(),
                            steps[3],
                            h_arrow.hflip(),
                            steps[2]))

fun animation_example(i, adjust):
  let [from, to] = fish_steps[i]
  let from = steps[i].find_rebuilt(from)
  explain_anim(steps[i].replace(from, adjust(from, to)).sustain(),
               ~steps: 3,
               ~end: 1,
               ~show_timebox: #false)

def morph_example:
  animation_example(0, morph)

def wiggle_example:
  animation_example(0, fun (from, to): wiggle(from))

def eval_slide_code:
  rhombusblock(
    slide(~title: "Making Fish",
          fish_eval_steps,
          slide.next, // wait for space bar to expose later
          para("Now you know how to draw fish functionally!"))
  )

def (fish_code2 :: Pict, fish_val :: Pict, fish_sched):  
  eval_tree:
    overlay(ellipse(~width: 50,
                    ~height: 25,
                    ~fill: "lightblue"),
            ~dx: 30, ~dy: 0,
            triangle(~size: 25,
                     ~fill: "lightblue")
              .rotate(1/2 * math.pi))

def big_step_pict:
  big_steps(fish_code2,
            fish_sched,
            ~as_tail: #true)

def big_step_sequence:
  let l = [big_step_pict.snapshot(3),
           big_step_pict.snapshot(4),
           big_step_pict.snapshot(5),
           big_step_pict.snapshot(6),
           big_step_pict.snapshot(7)]
  let b = overlay(&l).blank()
  let l: for List (p :~ Pict in l,
                   i in 1..):
           overlay.bottom_right(overlay(p, b).pad(30), text(to_string(i)).pad(10))
  stack(~sep: 20,
        &l.map(fun(p): rectangle(~around: p, ~line: "gray")))

module main:
  import:
    slideshow open
  def (fish_code :: Pict, fish_val :: Pict, fish_sched :: Eval):
    #//
    eval_tree:
      :
        def body = ellipse(~width: 100,
                           ~height: 50,
                           ~fill: "lightblue")
        def tail = triangle(~size: 50,
                            ~fill: "lightblue")
        overlay(~dx: 60, ~dy: 0,
                & [body],
                (tail.rotate(1/2 * math.pi)))
    #//
    eval_tree:
      overlay(~dx: 60, ~dy: 0,
              if #true
              | if #false
                | "oops"
                | ellipse(~width: 100,
                          ~height: 50,
                          ~fill: "lightblue")
              | "ack",
              triangle(~size: 50,
                       ~fill: "lightblue")
                .rotate(1/2 * math.pi))
    eval_tree:
      overlay(ellipse(~width: 100,
                      ~height: 50,
                      ~fill: "lightblue"),
              ~dx: 60, ~dy: 0,
              triangle(~size: 50,
                       ~fill: "lightblue")
                .rotate(1/2 * math.pi))

  def fish_steps = sched_to_redex_list(fish_sched)

  fun fixed_bounds(p :~ Pict):
    overlay(p, max_bounds(p))

  slide(~title: "Making Fish",
        small_steps(fish_code,
                    fish_steps),
        slide.next,
        blank(),
        @para{Now you know how to draw fish functionally!})

  slide(
    big_steps(fish_code,
              fish_sched,
              ~as_tail: #true)
  )
