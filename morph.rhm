#lang rhombus/static

// `morph` animates a transition from `from` to `to` by cross-fading
// the two picts while interpolating their bounding boxes. Built on
// `cross_fade` from the pict library.

import:
  pict open

export:
  morph

fun morph(from :: StaticPict, to :: StaticPict):
  let b = overlay(from, to).ghost().launder()
  switch(~join: #'splice,
         cross_fade(overlay(from, b), overlay(to, b)),
         overlay(to, cross_fade(b, to.ghost().launder())))
