#lang rhombus/static
import:
  pict open
  "wiggle.rhm" open
  "morph.rhm" open

export:
  small_steps

fun wiggle_then_morph(~in: p :: Pict,
                      ~from: from :: Pict,
                      ~to: to :: Pict) :: Pict:
  let w_p = p.replace(from, wiggle(from))
  let m_p = p.replace(from, morph(from, to))
  switch(w_p, m_p).sustain()

fun small_step(prev_p :: Pict, from, to) :: Pict:
  let p = prev_p.snapshot(prev_p.duration-1, 1)
  let from = p.find_rebuilt(from) || error("cannot find",
                                           error.val(~label: "pict", from),
                                           error.val(~label: "in", p))
  let new_p = wiggle_then_morph(~in: p, ~from: from, ~to: to)
  switch(prev_p, new_p,
         // starting point of `new_p` matches end of `prev_p`,
         // so splice:
         ~join: #'splice)

fun small_steps(p :: Pict, steps :: List) :: Pict:
  // Fold over small steps
  for fold (p = p) ([from, to] in steps):
    small_step(p, from, to)

module code:
  import:
    pict/rhombus open

  export:
    use_small_steps_code
    small_steps_code
    small_step_code
    wiggle_then_morph_code

  def use_small_steps_code:
    @rhombusblock(
      def fish_eval_steps = small_steps(fish_code, fish_steps)
    )

  def small_steps_code:
    @rhombusblock(      
      fun small_steps(p :: Pict, steps :: List) :: Pict:
        for fold (p = p):
          each [from, to] in steps
          small_step(p, from, to)
    )

  def small_step_code:
    @rhombusblock(
      fun small_step(prev_p :: Pict, from :: Pict, to :: Pict) :: Pict:
        def p = prev_p.snapshot(prev_p.duration-1, 1)
        def from = p.find_rebuilt(from)
        def new_p = wiggle_then_morph(p, from, to)
        switch(prev_p, new_p, ~join: SequentialJoin.splice)
    )

  def wiggle_then_morph_code:
    @rhombusblock(
      fun wiggle_then_morph(p :: Pict, from :: Pict, to :: Pict) :: Pict:
        def w_p = p.replace(from, wiggle(from))
        def m_p = p.replace(from, morph(from, to))
        switch(w_p, m_p).sustain()
    )
