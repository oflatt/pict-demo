#lang rhombus/static

// Small-step animation: given a starting pict and a list of
// `[from, to]` reduction steps, produces an animation that for
// each step wiggles the `from` subexpression in place, then
// morphs it into `to`, splicing the per-step animations together.

import:
  pict open
  "wiggle.rhm" open
  "morph.rhm" open

export:
  small_steps

// Animate one reduction: wiggle `from` in place, then morph to `to`.
fun wiggle_then_morph(~in: p :: Pict,
                      ~from: from :: Pict,
                      ~to: to :: Pict) :: Pict:
  let w_p = p.replace(from, wiggle(from))
  let m_p = p.replace(from, morph(from, to))
  switch(w_p, m_p).sustain()

// Append one small-step animation onto the end of `prev_p`.
fun small_step(prev_p :: Pict, from, to) :: Pict:
  let p = prev_p.snapshot(prev_p.duration-1, 1)
  let from = p.find_rebuilt(from) || error("cannot find",
                                           error.val(~label: "pict", from),
                                           error.val(~label: "in", p))
  let new_p = wiggle_then_morph(~in: p, ~from: from, ~to: to)
  switch(prev_p, new_p,
         // starting point of `new_p` matches end of `prev_p`,
         // so splice:
         ~join: #'splice)

// Fold `small_step` over a list of `[from, to]` reduction steps.
fun small_steps(p :: Pict, steps :: List) :: Pict:
  for fold (p = p) ([from, to] in steps):
    small_step(p, from, to)
