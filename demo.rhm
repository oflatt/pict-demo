#lang rhombus

// Slideshow demo for the ICFP 2026 artifact. Run with
//   rhombus demo.rhm
// It opens three slides:
//   1. A dragon-curve drawn from fish picts.
//   2. A small-step evaluation of the fish expression.
//   3. A big-step evaluation of the same fish expression.

import:
  pict open
  pict/rhombus open
  "small_steps.rhm" open
  "wiggle.rhm" open
  "morph.rhm" open
  "eval_tree.rhm" open
  "big_steps.rhm" open
  slideshow open

def fish:
  overlay(ellipse(~width: 50,
                  ~height: 25,
                  ~fill: "lightblue"),
          ~dx: 30, ~dy: 0,
          triangle(~size: 25,
                   ~fill: "lightblue")
            .rotate(1/2 * math.pi))

fun sea_dragon(n :: Nat)
  :: List.of(Int.in(0,1)):
  match n
  | 0: []
  | ~else:
      def [x, ...] = sea_dragon(n-1)
      def [y, ...] = [x, ...].reverse()
      [x, ..., 0, 1-y, ...]

fun check_interleave(n :: Nat)
  :: Boolean:
  def [dn, dn1]:
    [sea_dragon(n), sea_dragon(n+1)]
  for all:
    each i in 0..dn.length()
    dn1[i*2+1] == dn[i]
      && dn1[i*2] == i mod 2

check sea_dragon(1) ~is [0]
check sea_dragon(2) ~is [0,0,1]
check check_interleave(1) ~is #true
check check_interleave(2) ~is #true
check check_interleave(3) ~is #true
check check_interleave(4) ~is #true
check check_interleave(5) ~is #true

fun dragon_pict(n :: Int) :: Pict:
  def [curve, _, _, _]:
    for fold([p, x, y, θ] = [blank(), 0, 0, 0]):
      each i in sea_dragon(n)
      def nx = x + math.cos(θ)*fish.width
      def ny = y + math.sin(θ)*fish.width
      [overlay(p, ~dx: x, ~dy: y, rotated_fish(θ))
         .refocus(p),
       nx, ny,
       θ - (i*2-1)*math.pi/2]
  curve.refocus_around_ink()

fun rotated_fish(θ :: Real) :: Pict:
  def nose = blank()
  beside(nose, fish)
    .refocus(nose)
    .rotate(-θ)


slide(~title: "Dragon Curve", dragon_pict(11).scale(1/10))




def (fish_code :: Pict, fish_val :: Pict, fish_sched):
  eval_tree:
    overlay(ellipse(~width: 50,
                    ~height: 25,
                    ~fill: "lightblue"),
            ~dx: 30, ~dy: 0,
            triangle(~size: 25,
                     ~fill: "lightblue")
              .rotate(1/2 * math.pi))

def fish_steps = sched_to_redex_list(fish_sched)


slide(~title: "Making Fish",
      small_steps(fish_code,
                  fish_steps),
      slide.next,
      blank(),
      @para{Now you know how to draw fish functionally!})

slide(
  big_steps(fish_code,
            fish_sched,
            ~as_tail: #true)
)
